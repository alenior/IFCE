#include <16F874.h>   //Biblioteca do PIC utilizado  

#use delay(clock=1000000)
#fuses XT,NOWDT,NOPUT

void main() {

  while(TRUE){
     output_c(0b00100001);
     delay_ms(15000);
     output_c(0b00010001);
     delay_ms(2000);
     output_c(0b00001100);
     delay_ms(15000);
     output_c(0b00001010);
     delay_ms(2000);
     }
}
