#define OVFL_INT 0x0100
#define CAPT_L2H 0x0040
#define CAPT_H2L 0x0000
#define EXT_L2H  0x0020
#define EXT_H2L  0x0000
#define tSW      0x0000
#define tPWM     0x0001
#define tCC      0x0002
#define tEXT     0x0003
    /// Prescale
#define DIV_BY_1  0x0000
